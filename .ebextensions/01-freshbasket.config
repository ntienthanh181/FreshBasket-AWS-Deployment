# Elastic Beanstalk defaults file

option_settings:
  # Load balancer health check -> lightweight route that does not depend on RDS
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    Port: '80'
    Protocol: HTTP

  # Auto Scaling Group: minimum 2, maximum 4 instances
  aws:autoscaling:asg:
    MinSize: '2'
    MaxSize: '4'

  # Scale out when average CPU > 60 %, scale in when average CPU < 30 %
  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    UpperThreshold: '60'
    UpperBreachScaleIncrement: '1'
    LowerThreshold: '30'
    LowerBreachScaleIncrement: '-1'
    Period: '5'
    BreachDuration: '5'
